DATABASE_URL="file:/app/data/smcs.db"
APP_URL="https://smcs.example.com"
SMCS_HOST="smcs2.srv1738397.hstgr.cloud"
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

TRAEFIK_NETWORK_NAME="traefik_net"
TRAEFIK_ENTRYPOINT="websecure"
TRAEFIK_CERTRESOLVER="myresolver"
SESSION_SECRET="generate-a-long-random-secret"
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
CONTENT_STUDIO_PUBLISH_MODE="simulated"
SEED_DEMO_DATA="false"

# Optional provider-neutral OpenAI-compatible endpoint.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# Optional n8n protection.
N8N_INGESTION_TOKEN="generate-a-long-random-token"
# Use the container's service name or explicit container name on traefik_net
N8N_API_URL=http://n8n-with-ai-assistant-emty-n8n-1:5678
# or http://n8n:5678 if n8n service is aliased as n8n on traefik_net

# Required only for live LinkedIn publishing.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="https://smcs.example.com/api/linkedin/callback"
LINKEDIN_API_VERSION="202508"
